+#ifdef __IOS__
+            /* GS_IOS (overlay 0053, D20): touch drag-look. The shell's drag,
+             * drained once per tick in right-stick units, rides player 1's
+             * stick2X/Y exactly like a right-stick deflection. */
+            if (i == 0) {
+                extern void SohIos_TouchLookDrain(float* x, float* y);
+                f32 gsTlX, gsTlY;
+                SohIos_TouchLookDrain(&gsTlX, &gsTlY);
+                if (gCurrDemoInput == NULL) {
+                    controller->stick2X += gsTlX;
+                    controller->stick2Y += gsTlY;
+                }
+            }
+#endif
         } else { // otherwise, if the controllerData is NULL, 0 out all of the inputs.
             controller->rawStickX = 0;
             controller->rawStickY = 0;
