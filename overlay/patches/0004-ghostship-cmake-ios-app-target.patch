+    set(GS_IOS_BUNDLE_IDENTIFIER "com.harbourmasters.ghostship" CACHE STRING "iOS bundle identifier")
+    set(GS_IOS_DEVELOPMENT_TEAM "" CACHE STRING "Development team for iOS code signing")
+    set_target_properties(${PROJECT_NAME} PROPERTIES
+        XCODE_ATTRIBUTE_CLANG_ENABLE_OBJC_ARC YES
+        XCODE_ATTRIBUTE_PRODUCT_BUNDLE_IDENTIFIER "${GS_IOS_BUNDLE_IDENTIFIER}"
