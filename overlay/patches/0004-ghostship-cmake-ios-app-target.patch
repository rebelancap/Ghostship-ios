+        string(FIND "${GS_VISION_PLIST}" "<string>SohIosSceneDelegate</string>" GS_IPHONE_MANIFEST_AT)
+        if(GS_IPHONE_MANIFEST_AT EQUAL -1)
+            message(FATAL_ERROR "D18: iPhone scene manifest not found in ios/plist.in (overlay 0004)")
+        endif()
+        string(REPLACE "	<key>UIApplicationSceneManifest</key>
+	<dict>
+		<key>UIApplicationSupportsMultipleScenes</key>
+		<false/>
+		<key>UISceneConfigurations</key>
+		<dict>
+			<key>UIWindowSceneSessionRoleApplication</key>
+			<array>
+				<dict>
+					<key>UISceneConfigurationName</key>
+					<string>Default</string>
+					<key>UISceneDelegateClassName</key>
+					<string>SohIosSceneDelegate</string>
+					<key>UISceneClassName</key>
+					<string>UIWindowScene</string>
+				</dict>
+			</array>
+		</dict>
+	</dict>
+" "" GS_VISION_PLIST "${GS_VISION_PLIST}")
+        string(FIND "${GS_VISION_PLIST}" "SohIosSceneDelegate" GS_IPHONE_MANIFEST_LEFT)
+        if(NOT GS_IPHONE_MANIFEST_LEFT EQUAL -1)
+            message(FATAL_ERROR "D18: iPhone scene manifest not stripped from the vision plist")
+        endif()
+        string(REPLACE "</dict>
+</plist>" "	<key>UIApplicationSceneManifest</key>
+	<dict>
+		<key>UIApplicationSupportsMultipleScenes</key>
+		<true/>
+	</dict>
+</dict>
+</plist>" GS_VISION_PLIST "${GS_VISION_PLIST}")
+        file(WRITE "${CMAKE_BINARY_DIR}/plist-vision.in" "${GS_VISION_PLIST}")
+        set_target_properties(${PROJECT_NAME} PROPERTIES
+            MACOSX_BUNDLE_INFO_PLIST "${CMAKE_BINARY_DIR}/plist-vision.in")
+    endif()
 endif()
 
