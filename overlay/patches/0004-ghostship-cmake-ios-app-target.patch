+    target_link_libraries(${PROJECT_NAME} PRIVATE "$<$<NOT:$<BOOL:${GS_VISIONOS}>>:SDL2main>")
+    # iOS app shell (touch overlay, console bridge, onboarding) lives in
+    # the port repo, passed as -DGS_IOS_SHELL_DIR.
+    if(NOT EXISTS "${GS_IOS_SHELL_DIR}/SohIosShell.m")
+        message(FATAL_ERROR "iOS build requires -DGS_IOS_SHELL_DIR=<dir with SohIosShell.m>")
+    endif()
+    target_sources(${PROJECT_NAME} PRIVATE "${GS_IOS_SHELL_DIR}/SohIosShell.m")
+    target_include_directories(${PROJECT_NAME} PRIVATE "${GS_IOS_SHELL_DIR}")
+    # GS_IOS (0004 rev4): app icon via ASSET CATALOG. Upstream ships a flat
+    # 200x200 ios/Icon.png through the legacy CFBundleIconFile — iOS tolerates
+    # that, but visionOS IGNORES it entirely and needs a LAYERED icon
+    # (AppIcon.solidimagestack: Front subject + Back plate, which the system
+    # parallaxes and crops to a circle). The catalog carries both: an
+    # AppIcon.appiconset for iOS/iPadOS and the solidimagestack for visionOS.
+    # Art is upstream's own logo.png (the ghost galleon + anchor).
+    if(NOT EXISTS "${GS_IOS_SHELL_DIR}/Assets.xcassets")
+        message(FATAL_ERROR "iOS build requires ${GS_IOS_SHELL_DIR}/Assets.xcassets (app icon catalog)")
+    endif()
+    target_sources(${PROJECT_NAME} PRIVATE "${GS_IOS_SHELL_DIR}/Assets.xcassets")
+    set_source_files_properties("${GS_IOS_SHELL_DIR}/Assets.xcassets" PROPERTIES
+        MACOSX_PACKAGE_LOCATION Resources)
+    set_target_properties(${PROJECT_NAME} PROPERTIES
+        XCODE_ATTRIBUTE_ASSETCATALOG_COMPILER_APPICON_NAME "AppIcon")
+    # GS_IOS (0004 rev5): the remote console bridge is a DEV tool — it injects
+    # input, writes CVars and reads crash.txt/logs — so upstream-of-us (the
+    # reference shell, 3698809) compiles it out behind SOH_REMOTE_CONSOLE and
+    # public builds cannot expose it at all. Ghostship defaults it ON because
+    # every build we ship goes to exactly one person over a private tailnet,
+    # and this bridge is our ONLY on-device debugging channel (moddir/cvar/
+    # hideprobe all ride it). It still needs a runtime opt-in at launch
+    # (SOH_CONSOLE env, the gSohIos.RemoteConsole setting, or a console_enabled
+    # file), so compiling it in does not open a port by itself.
+    option(SOH_REMOTE_CONSOLE "Compile in the remote console bridge (dev/private-OTA builds)" ON)
+    if(SOH_REMOTE_CONSOLE)
