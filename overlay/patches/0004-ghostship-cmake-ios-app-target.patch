+#ifdef __IOS__
+// SDL2main's UIKit shim provides the real main() -> UIApplicationMain ->
+// SDL_main on the main thread. SDL_main.h renames our main() and declares
+// it with C linkage (a bare -Dmain=SDL_main would leave it C++-mangled and
+// SDL2main's expected _SDL_main symbol unresolved).
+#include <SDL2/SDL_main.h>
+#endif
+
 void alloc_pool() {
     static u64 pool[1024 * 1024 * 4];
     main_pool_init(pool, pool + sizeof(pool) / sizeof(pool[0]));
