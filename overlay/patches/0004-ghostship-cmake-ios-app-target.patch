+        message(STATUS "ghostship: remote console COMPILED IN (private OTA build)")
+    else()
+        message(STATUS "ghostship: remote console compiled out (public-safe)")
+    endif()
+    target_link_libraries(${PROJECT_NAME} PRIVATE "-framework UniformTypeIdentifiers"
+                                                  "-framework GameController")
+    # Resources: host-built port archive, controller db, and the Torch
+    # extraction manifests (config.yml + assets/). The in-app extractor
+    # resolves the manifests via GetAppBundlePath (overlay 0005).
+    set(GS_O2R_PATH "" CACHE FILEPATH "Path to a host-built ghostship.o2r to bundle")
+    if(NOT EXISTS "${GS_O2R_PATH}")
+        message(FATAL_ERROR "iOS build requires -DGS_O2R_PATH=<host-built ghostship.o2r>")
+    endif()
+    target_sources(${PROJECT_NAME} PRIVATE "${GS_O2R_PATH}" "${CMAKE_BINARY_DIR}/gamecontrollerdb.txt"
+                                           "${CMAKE_CURRENT_SOURCE_DIR}/config.yml")
+    set_source_files_properties("${GS_O2R_PATH}" "${CMAKE_BINARY_DIR}/gamecontrollerdb.txt"
+        "${CMAKE_CURRENT_SOURCE_DIR}/config.yml" PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
+    add_custom_command(TARGET ${PROJECT_NAME} POST_BUILD
+        COMMAND ${CMAKE_COMMAND} -E copy_directory "${CMAKE_SOURCE_DIR}/assets"
+                "$<TARGET_BUNDLE_DIR:${PROJECT_NAME}>/assets"
+        COMMENT "Bundling Torch asset manifests (assets/)...")
+    if(GS_VISIONOS)
+        # GS_IOS (overlay 0004 rev3, vision playbook §1.2): SwiftUI app entry
+        # in its OWN flag-clean static lib — the Xcode generator ignores
+        # COMPILE_LANGUAGE genexes when composing OTHER_SWIFT_FLAGS, so any
+        # .swift source on the game target inherits its C warning flags and
+        # swiftc hard-errors. Swift's @main emits main; force_load extracts
+        # it from the archive (nothing else references the Swift objects).
+        enable_language(Swift)
+        add_library(ghostshipvisionswift STATIC "${GS_IOS_SHELL_DIR}/SohVisionApp.swift")
+        set_target_properties(ghostshipvisionswift PROPERTIES
+            XCODE_ATTRIBUTE_SWIFT_VERSION "5.0"
+            XCODE_ATTRIBUTE_SWIFT_OBJC_BRIDGING_HEADER "${GS_IOS_SHELL_DIR}/SohVision-Bridging-Header.h")
+        target_sources(${PROJECT_NAME} PRIVATE
+            "${GS_IOS_SHELL_DIR}/SohHostViewController.m"
+            "${GS_IOS_SHELL_DIR}/SohImmersive.m")
+        target_link_libraries(${PROJECT_NAME} PRIVATE
+            "-Wl,-force_load,$<TARGET_FILE:ghostshipvisionswift>"
+            "-L$(SDKROOT)/usr/lib/swift"
+            "-framework CompositorServices" "-framework ARKit" "-framework AVFAudio")
+        add_dependencies(${PROJECT_NAME} ghostshipvisionswift)
+        # ImmersiveSpace needs UIApplicationSupportsMultipleScenes INSIDE the
+        # UIApplicationSceneManifest dict (top-level is silently ignored).
+        # The key changes iPhone scene behavior, so it is spliced ONLY into a
+        # vision copy of the plist.
+        file(READ "${CMAKE_CURRENT_SOURCE_DIR}/ios/plist.in" GS_VISION_PLIST)
+        # D18: plist.in carries the iPhone scene manifest (iOS 27 SDK launch
